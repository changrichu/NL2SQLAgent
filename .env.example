# ===== LLM Provider =====
# Choose one: openai | deepseek | qwen | doubao | zhipu
LLM_PROVIDER=deepseek
LLM_MODEL=

# ===== API Keys (pick the one matching LLM_PROVIDER) =====
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DOUBAO_API_KEY=
ZHIPU_API_KEY=

# ===== Database (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=askdata_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ===== Safety =====
SQL_MAX_ROWS=10000
SANDBOX_TIMEOUT=30
